
local M = {}

function M.setup()
  local ok_renderer, renderer = pcall(require, "neo-tree.ui.renderer")
  if not ok_renderer then
    return
  end
  if renderer._catppuccin_patched then
    return
  end
  local function render_state(state)
    local ok_icons, icons = pcall(require, "catppuccin_full_icon_logic")
    if ok_icons then
      icons.render_neotree_state(state)
    end
  end

  local orig_show_nodes = renderer.show_nodes
  renderer.show_nodes = function(sourceItems, state, parentId, callback)
    local res = orig_show_nodes(sourceItems, state, parentId, callback)
    if state and not state._in_pre_render then
      render_state(state)
    end
    return res
  end

  local orig_redraw = renderer.redraw
  renderer.redraw = function(state)
    local res = orig_redraw(state)
    if state and not state._in_pre_render then
      render_state(state)
    end
    return res
  end

  renderer._catppuccin_patched = true
end

return M
