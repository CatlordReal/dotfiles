#!/bin/zsh
set -euo pipefail

BASE="$HOME/.config/utilities"
STATE_DIR="$HOME/.cache/wallust"
ACTIVE="$STATE_DIR/active_wallpaper_dir"
LAST="$STATE_DIR/last_wallpaper"

mkdir -p "$STATE_DIR"

d1="$BASE/Wallpapers"
d2="$BASE/Wallpapers-Full"

resolve_dir() {
  case "${1:-active}" in
    1|Wallpapers|normal) echo "$d1" ;;
    2|full|Wallpapers-Full) echo "$d2" ;;
    active|"")
      if [[ -f "$ACTIVE" ]]; then cat "$ACTIVE"; else echo "$d1"; fi
      ;;
    *) echo "$1" ;;
  esac
}

list_images() {
  find "$1" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.heic' \) -print
}

pick_random() {
  if command -v shuf >/dev/null 2>&1; then
    list_images "$1" | shuf -n 1
  elif command -v gshuf >/dev/null 2>&1; then
    list_images "$1" | gshuf -n 1
  else
    echo "Neither shuf nor gshuf found. Install coreutils: brew install coreutils" >&2
    return 1
  fi
}

pick_interactive() {
  if command -v fzf >/dev/null 2>&1; then
    list_images "$1" | sed "s|^$1/||" | fzf --prompt="Wallpaper > " | awk -v d="$1" '{print d "/" $0}'
  else
    python3 - <<'PY' "$1"
import os, sys
d=sys.argv[1]
files=[]
for root, _, fnames in os.walk(d):
  for f in fnames:
    lf=f.lower()
    if lf.endswith((".png",".jpg",".jpeg",".webp",".heic")):
      files.append(os.path.join(root,f))
files.sort()
if not files:
  raise SystemExit(1)
for i,f in enumerate(files,1):
  print(f"{i:4d}  {os.path.relpath(f,d)}")
idx=int(input("Number: ").strip())
print(files[idx-1])
PY
  fi
}

set_wallpaper() {
  osascript -e "tell application \"System Events\" to tell every desktop to set picture to POSIX file \"${1//\"/\\\"}\""
}

apply_theme() {
  wallust run --skip-sequences "$1" >/dev/null
  kitty @ load-config >/dev/null 2>&1 || true
  kitty @ set-colors --all --configured "$HOME/.config/kitty/current-theme.conf" >/dev/null 2>&1 || true
  echo "$1" > "$LAST"
}

cmd="${1:-}"
arg="${2:-}"

case "$cmd" in
  dir)
    dir="$(resolve_dir "$arg")"
    echo "$dir" > "$ACTIVE"
    ;;
  random)
    dir="$(resolve_dir "$arg")"
    img="$(pick_random "$dir")"
    set_wallpaper "$img"
    apply_theme "$img"
    ;;
  pick)
    dir="$(resolve_dir "$arg")"
    img="$(pick_interactive "$dir")"
    set_wallpaper "$img"
    apply_theme "$img"
    ;;
  current)
    osascript -e 'tell app "finder" to get posix path of (get desktop picture as alias)'
    ;;
  *)
    cat <<'TXT'
Usage:
  wallpaper dir <1|2|Wallpapers|full|Wallpapers-Full|normal>
  wallpaper pick [active|1|2|<path>]
  wallpaper random [active|1|2|<path>]
  wallpaper current
TXT
    ;;
esac
