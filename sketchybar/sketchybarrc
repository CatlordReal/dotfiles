#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

source "$CONFIG_DIR/colors.sh"

FONT="JetBrainsMono Nerd Font Mono"
BAR_HEIGHT=34

sketchybar --bar \
  position=top \
  height="$BAR_HEIGHT" \
  color="$BAR_COLOR" \
  blur_radius=24 \
  sticky=on \
  padding_left=8 \
  padding_right=8 \
  y_offset=0 \
  margin=0

defaults=(
  updates=when_shown
  icon.font="$FONT:Bold:14.0"
  label.font="$FONT:Medium:13.0"
  icon.color="$TEXT"
  label.color="$TEXT"
  icon.padding_left=7
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=7
  background.drawing=on
  background.height=24
  background.corner_radius=7
  background.border_width=1
  background.border_color="$BORDER"
  background.color="$ITEM_BG"
)
sketchybar --default "${defaults[@]}"

sketchybar --add event aerospace_workspace_change

for workspace in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$workspace" left \
    --set "space.$workspace" \
      icon="$workspace" \
      label.drawing=off \
      script="$PLUGIN_DIR/aerospace_workspace.sh" \
      click_script="aerospace workspace $workspace" \
    --subscribe "space.$workspace" aerospace_workspace_change
done

sketchybar --add item separator left \
  --set separator \
    icon="|" \
    icon.color="$MUTED" \
    label.drawing=off \
    background.drawing=off

sketchybar --add item front_app left \
  --set front_app \
    icon="󰣆" \
    icon.color="$ACCENT_ALT" \
    label.max_chars=42 \
    script="$PLUGIN_DIR/front_app.sh" \
    background.color="$TRANSPARENT" \
    background.border_color="$TRANSPARENT" \
  --subscribe front_app front_app_switched

sketchybar --add item tiling_mode right \
  --set tiling_mode \
    icon="󰘧" \
    icon.color="$ACCENT" \
    label="Catppuccin" \
    script="$PLUGIN_DIR/tiling_mode.sh" \
    update_freq=20

sketchybar --add item battery right \
  --set battery \
    icon="󰁹" \
    script="$PLUGIN_DIR/battery.sh" \
    update_freq=60 \
  --subscribe battery system_woke power_source_change

sketchybar --add item clock right \
  --set clock \
    icon="󰥔" \
    icon.color="$SUCCESS" \
    script="$PLUGIN_DIR/clock.sh" \
    update_freq=20

sketchybar --update
