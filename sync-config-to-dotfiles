#!/usr/bin/env bash
set -Eeuo pipefail

DEFAULT_DIRS=(alacritty btop karabiner kitty nvim)
INCLUDE_DIRS=()
CONFIG_DIR="${CONFIG_DIR:-$HOME/.config}"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${REPO_ROOT:-}" ]]; then
    REPO_ROOT="$REPO_ROOT"
elif git -C "$SCRIPT_DIR" rev-parse --show-toplevel >/dev/null 2>&1; then
    REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
else
    REPO_ROOT="$SCRIPT_DIR"
fi
DRY_RUN=0
LIST_DEFAULTS=0

usage() {
    cat <<'USAGE'
Sync selected directories from ~/.config into this dotfiles repo.

Usage:
  ./sync-config-to-dotfiles [options]

Options:
  -i, --include DIR[,DIR...]  Add one or more .config directories to sync.
                              Repeatable.
  -c, --config-dir PATH       Source config directory. Default: ~/.config
  -r, --repo-root PATH        Dotfiles repo root. Default: detected git root
  -n, --dry-run               Show what would change without writing
  -l, --list-defaults         Print the default sync set and exit
  -h, --help                  Show this help

Default directories:
  alacritty, btop, karabiner, kitty, nvim

Examples:
  ./sync-config-to-dotfiles
  ./sync-config-to-dotfiles --dry-run
  ./sync-config-to-dotfiles --include scripts
  ./sync-config-to-dotfiles -i gh,nix
USAGE
}

log() {
    printf '[sync-config] %s\n' "$*"
}

die() {
    printf '[sync-config] error: %s\n' "$*" >&2
    exit 1
}

append_unique() {
    local value="$1"
    local current
    for current in "${SYNC_DIRS[@]:-}"; do
        [[ "$current" == "$value" ]] && return
    done
    SYNC_DIRS+=("$value")
}

add_include_arg() {
    local raw="$1"
    local part
    IFS=',' read -r -a parts <<< "$raw"
    for part in "${parts[@]}"; do
        part="${part## }"
        part="${part%% }"
        [[ -z "$part" ]] && continue
        INCLUDE_DIRS+=("$part")
    done
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--include)
            [[ $# -ge 2 ]] || die "missing value for $1"
            add_include_arg "$2"
            shift
            ;;
        --include=*)
            add_include_arg "${1#*=}"
            ;;
        -c|--config-dir)
            [[ $# -ge 2 ]] || die "missing value for $1"
            CONFIG_DIR="$2"
            shift
            ;;
        --config-dir=*)
            CONFIG_DIR="${1#*=}"
            ;;
        -r|--repo-root)
            [[ $# -ge 2 ]] || die "missing value for $1"
            REPO_ROOT="$2"
            shift
            ;;
        --repo-root=*)
            REPO_ROOT="${1#*=}"
            ;;
        -n|--dry-run)
            DRY_RUN=1
            ;;
        -l|--list-defaults)
            LIST_DEFAULTS=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
    shift
done

if [[ "$LIST_DEFAULTS" -eq 1 ]]; then
    printf '%s\n' "${DEFAULT_DIRS[@]}"
    exit 0
fi

command -v rsync >/dev/null 2>&1 || die "rsync is required"
[[ -d "$CONFIG_DIR" ]] || die "config dir not found: $CONFIG_DIR"
[[ -d "$REPO_ROOT" ]] || die "repo root not found: $REPO_ROOT"

SYNC_DIRS=()
for dir in "${DEFAULT_DIRS[@]}"; do
    append_unique "$dir"
done
for dir in "${INCLUDE_DIRS[@]}"; do
    append_unique "$dir"
done

RSYNC_OPTS=(-a --delete --exclude=.git/)
[[ "$DRY_RUN" -eq 1 ]] && RSYNC_OPTS+=(--dry-run --itemize-changes)

for dir in "${SYNC_DIRS[@]}"; do
    src="$CONFIG_DIR/$dir"
    dst="$REPO_ROOT/$dir"
    [[ -d "$src" ]] || die "source directory not found: $src"

    mkdir -p "$dst"
    log "syncing $dir"
    rsync "${RSYNC_OPTS[@]}" "$src/" "$dst/"
done
