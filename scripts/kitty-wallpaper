#!/usr/bin/env bash
set -euo pipefail

DIR="${KITTY_WALLPAPER_DIR:-$HOME/.config/wallpapers_blurred}"
CFG="${KITTY_CONFIG_DIR:-$HOME/.config/kitty}/kitty.conf"
MODE="${1:-pick}"

mapfile -t files < <(
  find "$DIR" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) -print | sort
)

(( ${#files[@]} > 0 )) || { echo "No wallpapers found in: $DIR" >&2; exit 1; }
[[ -f "$CFG" ]] || { echo "Missing config: $CFG" >&2; exit 1; }

choose_pick() {
  printf '%s\n' "${files[@]}" | sed "s|^$DIR/||" | fzf --prompt="Kitty wallpaper > " --height=40% --reverse
}

choose_random() {
  printf '%s\n' "${files[@]}" | shuf -n 1 | sed "s|^$DIR/||"
}

case "$MODE" in
  pick|select|fzf)
    rel="$(choose_pick)" || exit 0
    ;;
  random|rand|r)
    rel="$(choose_random)"
    ;;
  *)
    if [[ -f "$DIR/$MODE" ]]; then
      rel="$MODE"
    else
      rel="$(printf '%s\n' "${files[@]}" | sed "s|^$DIR/||" | awk -v q="$MODE" 'BEGIN{IGNORECASE=1} index($0,q){print; exit}')"
      [[ -n "${rel:-}" ]] || { echo "Not found: $MODE" >&2; exit 1; }
    fi
    ;;
esac

img="$DIR/$rel"
[[ -f "$img" ]] || { echo "Not found: $img" >&2; exit 1; }

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

awk -v img="$img" '
BEGIN{done=0}
$1=="background_image"{
  if(!done){ print "background_image " img; done=1 }
  next
}
{print}
END{ if(!done) print "background_image " img }
' "$CFG" > "$tmp"

mv "$tmp" "$CFG"

if kitty @ load-config >/dev/null 2>&1; then
  :
else
  echo "Updated $CFG, but could not reload running Kitty (remote control not reachable from this shell)." >&2
  echo "In Kitty, press Ctrl+Shift+F5 to reload config." >&2
fi

echo "$img"
