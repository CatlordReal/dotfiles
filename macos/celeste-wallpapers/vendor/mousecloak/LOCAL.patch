+BOOL dumpCursorsSafelyToFile(NSString *path, NSError **error) {
+    NSMutableDictionary *cursors = [NSMutableDictionary dictionary];
+    NSMutableArray *identifiers = [NSMutableArray array];
+
+    NSUInteger i = 0;
+    NSString *key = nil;
+    while ((key = defaultCursors[i++]) != nil)
+        [identifiers addObject:key];
+    [identifiers addObjectsFromArray:cursorAliases().allValues];
+    for (int index = 0; index < 45; index++)
+        [identifiers addObject:[NSString stringWithFormat:@"com.apple.cursor.%d", index]];
+
+    for (NSString *identifier in identifiers) {
+        NSDictionary *cursor = processedCapeWithIdentifier(identifier);
+        if (cursor)
+            cursors[identifier] = cursor;
+    }
+
+    if (!cursors[@"com.apple.coregraphics.ArrowS"] ||
+        !cursors[@"com.apple.coregraphics.IBeamS"]) {
+        if (error)
+            *error = [NSError errorWithDomain:MCErrorDomain code:MCErrorInvalidFormatCode
+                                     userInfo:@{NSLocalizedDescriptionKey:
+                                                    @"macOS 27 ArrowS/IBeamS cursors could not be captured."}];
+        return NO;
+    }
+
+    NSDictionary *cape = @{
+        MCCursorDictionaryAuthorKey: @"Local recovery snapshot",
+        MCCursorDictionaryCapeNameKey: @"Pre-Celeste Cursor Snapshot",
+        MCCursorDictionaryCapeVersionKey: @1.0,
+        MCCursorDictionaryCloudKey: @NO,
+        MCCursorDictionaryCursorsKey: cursors,
+        MCCursorDictionaryHiDPIKey: @YES,
+        MCCursorDictionaryIdentifierKey: @"com.kianconti.celeste.cursor-snapshot",
+        MCCursorDictionaryVersionKey: @(MCCursorCreatorVersion),
+        MCCursorDictionaryMinimumVersionKey: @(MCCursorParserVersion)
+    };
+    NSData *data = [NSPropertyListSerialization dataWithPropertyList:cape
+                                                               format:NSPropertyListBinaryFormat_v1_0
+                                                              options:0 error:error];
+    if (!data || ![data writeToFile:path options:NSDataWritingAtomic error:error])
+        return NO;
+    if (![[NSFileManager defaultManager] setAttributes:@{NSFilePosixPermissions: @0600}
+                                           ofItemAtPath:path error:error])
+        return NO;
+
+    NSData *written = [NSData dataWithContentsOfFile:path options:0 error:error];
+    NSDictionary *parsed = written ? [NSPropertyListSerialization propertyListWithData:written options:0 format:NULL error:error] : nil;
+    return [parsed[MCCursorDictionaryCursorsKey] isKindOfClass:[NSDictionary class]] &&
+           parsed[MCCursorDictionaryCursorsKey][@"com.apple.coregraphics.ArrowS"] &&
+           parsed[MCCursorDictionaryCursorsKey][@"com.apple.coregraphics.IBeamS"];
+}
